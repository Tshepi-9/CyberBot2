<Window x:Class="CyberBot2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="600"
        Width="800">

    <Grid Margin="10">

        <TabControl>

            <!-- ================= CHATBOT TAB ================= -->
            <TabItem Header="Chatbot">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <TextBlock Text="Enter Name:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>

                        <TextBox x:Name="NameTextBox"
                                 Width="200"
                                 Margin="0,0,10,0"/>

                        <Button x:Name="StartButton"
                                Content="Start Chat"
                                Width="100"
                                Click="StartButton_Click"/>

                    </StackPanel>

                    <TextBox x:Name="ChatDisplay"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap"
                             FontFamily="Consolas"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">

                        <TextBox x:Name="UserInput"
                                 Width="600"
                                 Height="30"
                                 Margin="0,0,10,0"/>

                        <Button x:Name="SendButton"
                                Content="Send"
                                Width="100"
                                Height="30"
                                Click="SendButton_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ================= TASK ASSISTANT TAB ================= -->
            <TabItem Header="Task Assistant">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Task Title"/>
                    <TextBox x:Name="TaskTitleTextBox"
                             Grid.Row="0"
                             Margin="0,20,0,5"
                             Height="30"/>

                    <TextBlock Grid.Row="1"
                               Text="Task Description"/>

                    <TextBox x:Name="TaskDescriptionTextBox"
                             Grid.Row="1"
                             Margin="0,20,0,5"
                             Height="30"/>

                    <TextBlock Grid.Row="2"
                               Text="Reminder"/>

                    <TextBox x:Name="TaskReminderTextBox"
                             Grid.Row="2"
                             Margin="0,20,0,5"
                             Height="30"/>

                    <Button x:Name="AddTaskButton"
                            Grid.Row="3"
                            Content="Add Task"
                            Height="30"
                            Margin="0,5"
                            Click="AddTaskButton_Click"/>

                    <ListBox x:Name="TaskListBox"
                             Grid.Row="4"
                             Margin="0,10"/>

                    <StackPanel Grid.Row="5"
                                Orientation="Horizontal">

                        <Button x:Name="CompleteTaskButton"
                                Content="Mark Complete"
                                Width="120"
                                Margin="0,0,10,0"
                                Click="CompleteTaskButton_Click"/>

                        <Button x:Name="DeleteTaskButton"
                                Content="Delete Task"
                                Width="120"
                                Click="DeleteTaskButton_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ================= QUIZ TAB (FIXED) ================= -->
            <TabItem Header="Quiz">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Score -->
                    <TextBlock x:Name="QuizScoreText"
                               FontSize="16"
                               FontWeight="Bold"
                               Text="Score: 0"
                               Margin="0,0,0,10"/>

                    <!-- Question -->
                    <TextBlock x:Name="QuizQuestionText"
                               Grid.Row="1"
                               FontSize="18"
                               TextWrapping="Wrap"
                               Margin="0,10,0,10"/>

                    <!-- Options -->
                    <StackPanel Grid.Row="2">

                        <RadioButton x:Name="OptionA" GroupName="QuizOptions" Margin="0,5"/>
                        <RadioButton x:Name="OptionB" GroupName="QuizOptions" Margin="0,5"/>
                        <RadioButton x:Name="OptionC" GroupName="QuizOptions" Margin="0,5"/>
                        <RadioButton x:Name="OptionD" GroupName="QuizOptions" Margin="0,5"/>

                    </StackPanel>

                    <!-- Buttons + Feedback -->
                    <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,10,0,0">

                        <Button x:Name="SubmitAnswerButton"
                                Content="Submit Answer"
                                Height="30"
                                Click="SubmitAnswerButton_Click"/>

                        <Button x:Name="NextQuestionButton"
                                Content="Next Question"
                                Height="30"
                                Margin="0,5,0,0"
                                Click="NextQuestionButton_Click"
                                Visibility="Collapsed"/>

                        <TextBlock x:Name="QuizFeedbackText"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Grid>

            </TabItem>

            <!-- ================= ACTIVITY LOG TAB (ADDED) ================= -->
            <TabItem Header="Activity Log">

                <Grid Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Activity Log"
                               FontSize="20"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <TextBox x:Name="ActivityLogBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="Consolas"
                             FontSize="12"/>

                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                Margin="0,10,0,0">

                        <Button x:Name="ShowRecentLogButton"
                                Content="Show Recent (10)"
                                Width="150"
                                Margin="0,0,10,0"
                                Click="ShowRecentLogButton_Click"/>

                        <Button x:Name="ShowFullLogButton"
                                Content="Show Full Log"
                                Width="150"
                                Margin="0,0,10,0"
                                Click="ShowFullLogButton_Click"/>

                        <Button x:Name="ClearLogViewButton"
                                Content="Clear View"
                                Width="120"
                                Click="ClearLogViewButton_Click"/>

                    </StackPanel>

                </Grid>

            </TabItem>

        </TabControl>

    </Grid>

</Window>